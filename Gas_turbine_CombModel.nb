    RowBox[{
     RowBox[{"{", 
      RowBox[{"formula", ",", "pairs"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Standardize", " ", "species", " ", "notation"}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"formula", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"species", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<AR\>\"", "->", "\"\<Ar\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Extract", " ", "element", " ", "symbols", " ", "and", " ", 
