           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"el", ",", "elist"}], "}"}]}], "]"}]}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",ExpressionUUID->"2c68d94f-979f-f144-afb2-1290006af707"],

