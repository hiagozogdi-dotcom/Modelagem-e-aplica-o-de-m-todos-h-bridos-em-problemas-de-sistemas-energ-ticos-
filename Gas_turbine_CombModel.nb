      RowBox[{"(*", 
       RowBox[{"Entropy", " ", "generation"}], "*)"}], "Sgcomp", ",", 
      "Sgcomb", ",", "Sgturb", ",", "SgTotal", ",", "\n", 
      RowBox[{"(*", "Performance", "*)"}], "Qh", ",", "Wl", ",", "\[Eta]Th", ",",
       "\[Eta]Carnot", ",", "\[Eta]ex", ",", "\[Tau]"}], "}"}], ",", "\n", 
    "\n", 
    RowBox[{"(*", "Pressures", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"P1", "=", "101325"}], ";", "\n", 
      RowBox[{"P4", "=", "P1"}], ";", "\n", 
      RowBox[{"\[CurlyPhi]", "=", "0.25"}], ";", "\n", "\n", 
