       RowBox[{"Ta_", "?", "NumericQ"}], ",", 
       RowBox[{"dH_", ":", "0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Hin", ",", "R", ",", 
         RowBox[{"c", "=", 
          RowBox[{"<|", "|>"}]}], ",", 
         RowBox[{"xw", "=", "Automatic"}], ",", "T", ",", "\[Tau]", ",", "n", 
         ",", "s"}], "}"}], ",", 
