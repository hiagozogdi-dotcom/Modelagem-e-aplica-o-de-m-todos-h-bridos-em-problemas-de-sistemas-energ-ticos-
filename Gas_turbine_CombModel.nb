           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"s", "===", "$Failed"}], ",", 
             RowBox[{"s", "=", 
              RowBox[{"EqTPx", "[", 
               RowBox[{"fu", ",", "mf", ",", "\[Phi]", ",", "t", ",", "P"}], 
               "]"}]}]}], "]"}], ";", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
