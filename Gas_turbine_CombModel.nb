        RowBox[{"(", 
         RowBox[{"y", "-", "p"}], ")"}], "^", "2"}], "]"}]}], ",", 
     RowBox[{"\"\<MAE\>\"", "->", 
      RowBox[{"Mean", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"y", "-", "p"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<MAPE (%)\>\"", "->", 
      RowBox[{"100", " ", 
       RowBox[{"Mean", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "p"}], ")"}], "/", "y"}], "]"}], "]"}]}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
