      "\[IndentingNewLine]", 
      RowBox[{"pairs", "=", 
       RowBox[{"StringCases", "[", 
        RowBox[{"formula", ",", 
         RowBox[{
          RowBox[{
          "RegularExpression", "[", "\"\<([A-Z][a-z]?)([0-9]*)\>\"", "]"}], ":>", 
          RowBox[{"{", 
           RowBox[{"\"\<$1\>\"", ",", "\"\<$2\>\""}], "}"}]}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"elist", ",", 
