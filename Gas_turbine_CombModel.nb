      "WturbinaS", ",", "Wturbina", ",", "mcorr", ",", "\[CurlyPhi]", ",", 
      "\n", 
      RowBox[{"(*", "Fuel", "*)"}], "nFuel", ",", "xFuel", ",", "LHV", ",", 
