           RowBox[{"fu", ",", "mf", ",", "\[Phi]", ",", "Tf", ",", "Ta"}], 
           "]"}], "+", "dH"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"R", "[", 
          RowBox[{"t_", "?", "NumericQ"}], "]"}], ":=", 
