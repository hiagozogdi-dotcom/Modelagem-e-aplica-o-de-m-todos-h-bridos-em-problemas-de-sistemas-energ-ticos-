      RowBox[{"P2", "=", 
       RowBox[{"P1", " ", "rp"}]}], ";", "\n", 
      RowBox[{"P3", "=", "P2"}], ";", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{"Isentropic", " ", "Compressor"}], "*)"}], "\n", 
      RowBox[{"If", "[", 
