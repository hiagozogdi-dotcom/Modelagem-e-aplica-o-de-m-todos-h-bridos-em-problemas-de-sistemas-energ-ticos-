             RowBox[{"p", "[", 
              RowBox[{"x", "[", 
               RowBox[{"[", "ite", "]"}], "]"}], "]"}]}]}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "GBT", " ", "com", " ", "a", " ", "configura\[CCedilla]\[ATilde]o", " ", 
    "da", " ", "Tabela", " ", "4", " ", "do", " ", "artigo"}], "*)"}]}], "\n", 
 RowBox[{
