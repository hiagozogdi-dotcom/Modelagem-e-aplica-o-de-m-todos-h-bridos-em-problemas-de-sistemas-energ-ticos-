     "estimador", " ", "linear", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"limite", " ", "\[Omega]"}], " ", "\[RightArrow]", " ", 
      "\[Infinity]"}], ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cvC", " ", "=", " ", 
