Notebook[{
Cell[BoxData["Quit"], "Input",ExpressionUUID->"284196f8-4b08-9547-8286-d365225439ba"],

Cell[CellGroupData[{

Cell["\<\
MAPs \[LongDash] Ajuste de mapas de compressor e turbina por \
Levenberg\[Dash]Marquardt (GasTurb)\
\>", "Title",ExpressionUUID->"d62f061f-679c-714e-b232-57c2d822ff0e"],

Cell["\<\
MapFit v3: m\[IAcute]nimos quadrados n\[ATilde]o lineares regularizados, \
erros-nas-vari\[AAcute]veis e invers\[ATilde]o robusta\
\>", "Subtitle",ExpressionUUID->"391bff39-7364-0d42-a970-5f20bc417fec"],

Cell["\<\
Este notebook substitui as etapas n\[ATilde]o lineares do MapFit_v2 por um \
\[UAcute]nico n\[UAcute]cleo Levenberg\[Dash]Marquardt (LM) com garantias de \
converg\[EHat]ncia global e local (Bergou, Diouane & Kungurtsev, 2020), \
escalonamento adaptativo e subproblema por decomposi\[CCedilla]\[ATilde]o \
ortogonal (Mor\[EAcute], 1978). O estimador linear do v2 \[EAcute] mantido \
como ponto de partida e como caso-limite (\[Omega] \[RightArrow] \
\[Infinity]). A interface exportada (CalcCompEff, CalcTurbEff, Funcwork, \
MapFit.mx) \[EAcute] id\[EHat]ntica \[AGrave] do v2.\
\>", "Text",ExpressionUUID->"0720596b-25d2-6c48-aad7-ec39b001fdd2"],

Cell["\<\
Requisito: MapasGasTurb.xlsx na mesma pasta do notebook (abas C_Rotacao, \
C_Eficiencia, C_Surge, C_Operacao, T_Rotacao, T_Eficiencia). Execute as se\
\[CCedilla]\[OTilde]es em ordem (Evaluation \[RightPointer] Evaluate \
Notebook).\
\>", "Text",ExpressionUUID->"1a366cd6-5309-4b42-8c8d-e6e69324ebe1"],

Cell[CellGroupData[{

Cell["0. Configura\[CCedilla]\[OTilde]es", "Section",ExpressionUUID->"bc9926b9-16ef-1943-9036-8a73745fa52e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"arq", "=", "\"\<MapasGasTurb.xlsx\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"imp", "[", "s_String", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"Rest", "@", 
      RowBox[{"Import", "[", 
       RowBox[{"arq", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Sheets\>\"", ",", "s"}], "}"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"NumericQ", "@", 
       RowBox[{"First", "[", "#", "]"}]}], "&"}]}], "]"}]}], 
  ";"}], "\n"}], "Input",ExpressionUUID->"f9811a6a-1950-8a4f-a366-\
8cba64c289fc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pal", " ", "=", " ", 
   RowBox[{"RGBColor", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<#1F4E3D\>\"", ",", " ", "\"\<#468966\>\"", ",", 
      " ", "\"\<#7BA05B\>\"", ",", " ", "\"\<#B5B35C\>\"", ",", 
      " ", "\"\<#D9B84A\>\"", ",", " ", "\"\<#FFB03B\>\"", ",", 
      " ", "\"\<#E07B2E\>\"", ",", " ", "\"\<#B64926\>\"", ",", 
      " ", "\"\<#8E2800\>\"", ",", " ", "\"\<#5C1A00\>\""}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ft", "=", 
   RowBox[{"Directive", "[", 
    RowBox[{
     RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
     RowBox[{"FontSize", "->", "16"}], ",", "Black"}], "]"}]}], 
  ";"}], "\n"}], "Input",ExpressionUUID->"f696d0e9-97a1-8f46-9fa4-\
5eede316a9a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pa", "[", "k_Integer", "]"}], " ", ":=", " ", 
    RowBox[{"pal", "[", 
     RowBox[{"[", 
      RowBox[{"Round", "@", 
       RowBox[{"Rescale", "[", 
        RowBox[{
         RowBox[{"Range", "@", "k"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"k", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "10"}], "}"}]}], "]"}]}], "]"}], "]"}]}], 
   ";"}], "     ", 
  RowBox[{"(*", " ", 
   RowBox[{"k", " ", "cores", " ", "da", " ", "paleta"}], " ", 
   "*)"}]}]], "Input",ExpressionUUID->"2ae1cb5d-e42f-5d4a-895e-1e31e60d9a68"]
}, Closed]],

Cell[CellGroupData[{

Cell["1. N\[UAcute]cleo Levenberg\[Dash]Marquardt", "Section",ExpressionUUID->"bfa042ec-d376-3843-a594-8f510fc8dd94"],

Cell[CellGroupData[{

Cell["1.1 Problema de m\[IAcute]nimos quadrados n\[ATilde]o lineares", \
"Subsection",ExpressionUUID->"b98dafdb-2731-2840-be66-6f09fdadc3f7"],

Cell["\<\
Todos os subproblemas de ajuste s\[ATilde]o escritos como a minimiza\
\[CCedilla]\[ATilde]o de metade da norma quadr\[AAcute]tica de um vetor de \
res\[IAcute]duos F (dados ponderados + termos de regulariza\[CCedilla]\
\[ATilde]o), sujeita a restri\[CCedilla]\[OTilde]es de caixa \
\[ScriptCapitalB]:\
\>", "Text",ExpressionUUID->"e3742efe-1daa-5b46-874f-c8101551867b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["min", 
      RowBox[{
       StyleBox["\[Theta]",
        FontWeight->"Bold"], "\[Element]", "\[ScriptCapitalB]"}]], " ", 
     RowBox[{"f", 
      RowBox[{"(", 
       StyleBox["\[Theta]",
        FontWeight->"Bold"], ")"}]}]}], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      RowBox[{"\:2016", 
       RowBox[{
        StyleBox["F",
         FontWeight->"Bold"], 
        RowBox[{"(", 
         StyleBox["\[Theta]",
          FontWeight->"Bold"], ")"}]}], "\:2016"}], "2"]}]}], ",", "   ", 
   RowBox[{
    StyleBox["F",
     FontWeight->"Bold"], ":", 
    SuperscriptBox["\:211d", "p"], "\[RightArrow]", 
    SuperscriptBox["\:211d", "m"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"abc17284-7a8c-\
5445-8fc5-14fa532a61b8"],

Cell["\<\
A cada itera\[CCedilla]\[ATilde]o j, o passo s\:2c7c minimiza o modelo \
linearizado regularizado (Bergou et al., eq. 2) com escalonamento diagonal D\
\:2c7c (Mor\[EAcute], eq. 2.4):\
\>", "Text",ExpressionUUID->"136c3dd6-0766-b048-8196-e05817237924"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    StyleBox["s",
     FontWeight->"Bold"], "j"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       UnderscriptBox[
        RowBox[{"arg", " ", "min"}], 
        StyleBox["s",
         FontWeight->"Bold"]], " ", 
       FractionBox["1", "2"], 
       SuperscriptBox[
        RowBox[{"\:2016", 
         RowBox[{
          SubscriptBox[
           StyleBox["F",
            FontWeight->"Bold"], "j"], "+", 
          SubscriptBox["J", "j"], 
          StyleBox["s",
           FontWeight->"Bold"]}], "\:2016"}], "2"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], 
       SubscriptBox["\[Gamma]", "j"], 
       SuperscriptBox[
        RowBox[{"\:2016", 
         RowBox[{
          SubscriptBox["D", "j"], 
          StyleBox["s",
           FontWeight->"Bold"]}], "\:2016"}], "2"]}]}], "  ", "\[DoubleLeftRightArrow]",
      "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["J", "j"], "\[DownTee]"], 
        SubscriptBox["J", "j"], "+", 
        SubscriptBox["\[Gamma]", "j"], 
        SuperscriptBox[
         SubscriptBox["D", "j"], "\[DownTee]"], 
        SubscriptBox["D", "j"]}], ")"}], 
      SubscriptBox[
       StyleBox["s",
        FontWeight->"Bold"], "j"]}]}], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       SubscriptBox["J", "j"], "\[DownTee]"]}], 
     SubscriptBox[
      StyleBox["F",
       FontWeight->"Bold"], "j"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"416320c7-6f52-\
004b-977f-3ded17391935"],

Cell["\<\
O sistema acima s\[ATilde]o as equa\[CCedilla]\[OTilde]es normais do problema \
aumentado abaixo, que \[EAcute] resolvido por decomposi\[CCedilla]\[ATilde]o \
ortogonal (LeastSquares) sem formar J\:1d40J \[LongDash] evita elevar ao \
quadrado o n\[UAcute]mero de condi\[CCedilla]\[ATilde]o quando J \[EAcute] \
quase deficiente de posto (Mor\[EAcute], eq. 3.2):\
\>", "Text",ExpressionUUID->"6c6afd92-0f46-be45-8304-791b95935b17"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", GridBox[{
      {
       SubscriptBox["J", "j"]},
      {
       RowBox[{
        SqrtBox[
         SubscriptBox["\[Gamma]", "j"]], 
        SubscriptBox["D", "j"]}]}
     }], "]"}], 
   StyleBox["s",
    FontWeight->"Bold"], "\[TildeFullEqual]", "-", 
   RowBox[{"[", GridBox[{
      {
       SubscriptBox[
        StyleBox["F",
         FontWeight->"Bold"], "j"]},
      {
       StyleBox["0",
        FontWeight->"Bold"]}
     }], "]"}]}], TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->\
"7d4be66b-e464-9c4d-904c-73eb34e9553b"]
}, Closed]],

Cell[CellGroupData[{

Cell["1.2 Par\[AHat]metro de regulariza\[CCedilla]\[ATilde]o e raz\[ATilde]o \
de redu\[CCedilla]\[ATilde]o", "Subsection",ExpressionUUID->"83177647-97dd-\
024e-b2c0-274b70e97dff"],

Cell["\<\
Escolha de Bergou et al. (2020): o par\[AHat]metro acompanha o quadrado do \
res\[IAcute]duo, o que permite \[Gamma] grande longe da solu\[CCedilla]\
\[ATilde]o (globaliza\[CCedilla]\[ATilde]o, complexidade \[CapitalOTilde](\
\[CurlyEpsilon]\:207b\.b2)) e \[Gamma] \[RightArrow] 0 perto dela (converg\
\[EHat]ncia local quadr\[AAcute]tica para res\[IAcute]duo nulo e linear para \
res\[IAcute]duo pequeno):\
\>", "Text",ExpressionUUID->"71dd5934-b478-ce41-9f9c-7366530cac63"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "j"], "=", 
   SubscriptBox["\[Mu]", "j"], 
   SuperscriptBox[
    RowBox[{"\:2016", 
     RowBox[{
      StyleBox["F",
       FontWeight->"Bold"], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["\[Theta]",
         FontWeight->"Bold"], "j"], ")"}]}], "\:2016"}], "2"]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"8fe4fe41-e689-\
854c-8d82-798d4ce26153"],

Cell["\<\
Atualiza\[CCedilla]\[ATilde]o com mem\[OAcute]ria \[Mu]\:0304 do \
\[UAcute]ltimo par\[AHat]metro bem-sucedido (variante V1; \[Eta] = 10\:207b\
\.b2, \[Lambda] = 5, \[Mu]_min = 10\:207b\.b9\:2076, \[Mu]\:2080 = \[Gamma]\
\:2080/\:2016F\:2080\:2016\.b2 com \[Gamma]\:2080 = 10\:207b\.b3):\
\>", "Text",ExpressionUUID->"2deda125-7cfe-0344-9912-e96b66f364a3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "j"], "\[GreaterEqual]", 
     RowBox[{"\[Eta]", ":", "  ", 
      SubscriptBox["\[Mu]", 
       RowBox[{"j", "+", "1"}]]}]}], "=", 
    RowBox[{"max", 
     RowBox[{"{", 
      SubscriptBox["\[Mu]", "min"], ",", 
      RowBox[{
       OverscriptBox["\[Mu]", "_"], "/", "\[Lambda]"}], "}"}]}]}], ",", "  ", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Mu]", "_"], "\[LeftArrow]", 
     SubscriptBox["\[Mu]", "j"]}], ";", "      ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "j"], "<", 
      RowBox[{"\[Eta]", ":", "  ", 
       SubscriptBox["\[Mu]", 
        RowBox[{"j", "+", "1"}]]}]}], "=", 
     RowBox[{"\[Lambda]", 
      SubscriptBox["\[Mu]", "j"]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"7e660b6a-f8da-\
4943-a07b-10e4d8157578"],

Cell["\<\
Raz\[ATilde]o entre redu\[CCedilla]\[ATilde]o real e prevista; para a solu\
\[CCedilla]\[ATilde]o exata do subproblema a redu\[CCedilla]\[ATilde]o \
prevista tem a forma estritamente n\[ATilde]o negativa abaixo (Mor\[EAcute], \
eq. 4.3\[Dash]4.4):\
\>", "Text",ExpressionUUID->"13aa0021-8b6d-1e4e-9697-43057c06ec5e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Rho]", "j"], "=", 
    FractionBox[
     RowBox[{"f", 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["\[Theta]",
         FontWeight->"Bold"], "j"], ")"}], "-", "f", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox[
         StyleBox["\[Theta]",
          FontWeight->"Bold"], "j"], "+", 
        SubscriptBox[
         StyleBox["s",
          FontWeight->"Bold"], "j"]}], ")"}]}], 
     RowBox[{
      SubscriptBox["m", "j"], 
      RowBox[{"(", 
       StyleBox["0",
        FontWeight->"Bold"], ")"}], "-", 
      SubscriptBox["m", "j"], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["s",
         FontWeight->"Bold"], "j"], ")"}]}]]}], ",", "   ", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["m", "j"], 
      RowBox[{"(", 
       StyleBox["0",
        FontWeight->"Bold"], ")"}]}], "-", 
     RowBox[{
      SubscriptBox["m", "j"], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["s",
         FontWeight->"Bold"], "j"], ")"}]}]}], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\:2016", 
          RowBox[{
           SubscriptBox["J", "j"], 
           SubscriptBox[
            StyleBox["s",
             FontWeight->"Bold"], "j"]}], "\:2016"}], "2"], "+", 
        SubscriptBox["\[Gamma]", "j"], 
        SuperscriptBox[
         RowBox[{"\:2016", 
          RowBox[{
           SubscriptBox["D", "j"], 
           SubscriptBox[
            StyleBox["s",
             FontWeight->"Bold"], "j"]}], "\:2016"}], "2"]}], ")"}]}], "\[GreaterEqual]",
      "0"}]}]}], TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->\
"201a0704-45b8-1842-964c-67dda129aa20"]
}, Closed]],

Cell[CellGroupData[{

Cell["1.3 Escalonamento adaptativo e crit\[EAcute]rios de parada", \
"Subsection",ExpressionUUID->"7023eb24-89cf-684c-ac15-cbf15b1f3d90"],

Cell["\<\
Escalonamento de Mor\[EAcute] (eq. 6.3), que torna o algoritmo invariante \
\[AGrave] escala dos par\[AHat]metros (coeficientes e coordenadas latentes t\
\[EHat]m ordens de grandeza distintas):\
\>", "Text",ExpressionUUID->"3f0f586e-8fc9-af44-b63d-7b9e99455e3b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubsuperscriptBox["d", "i", 
     RowBox[{"(", "0", ")"}]], "=", 
    RowBox[{"\:2016", 
     RowBox[{
      SubscriptBox["\[PartialD]", "i"], 
      StyleBox["F",
       FontWeight->"Bold"], 
      RowBox[{"(", 
       SubscriptBox[
        StyleBox["\[Theta]",
         FontWeight->"Bold"], "0"], ")"}]}], "\:2016"}]}], ",", "   ", 
   RowBox[{
    SubsuperscriptBox["d", "i", 
     RowBox[{"(", "j", ")"}]], "=", 
    RowBox[{"max", 
     RowBox[{"{", 
      SubsuperscriptBox["d", "i", 
       RowBox[{"(", 
        RowBox[{"j", "-", "1"}], ")"}]], ",", 
      RowBox[{"\:2016", 
       RowBox[{
        SubscriptBox["\[PartialD]", "i"], 
        StyleBox["F",
         FontWeight->"Bold"], 
        RowBox[{"(", 
         SubscriptBox[
          StyleBox["\[Theta]",
           FontWeight->"Bold"], "j"], ")"}]}], "\:2016"}], "}"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"daf9dd0c-9abc-\
084c-be67-5aea6848292f"],

Cell["\<\
Crit\[EAcute]rios invariantes \[AGrave] escala: cosseno escalado do gradiente \
(MINPACK), passo relativo (Mor\[EAcute] 8.3) e redu\[CCedilla]\[ATilde]o \
relativa prevista (Mor\[EAcute] 8.4):\
\>", "Text",ExpressionUUID->"2b8378b0-ce7c-6f40-b2a0-852991b31b2d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{
     UnderscriptBox["max", "i"], 
     FractionBox[
      RowBox[{"|", 
       SubscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["J", "\[DownTee]"], 
          StyleBox["F",
           FontWeight->"Bold"]}], ")"}], "i"], "|"}], 
      RowBox[{
       SubscriptBox["d", "i"], 
       RowBox[{"\:2016", 
        StyleBox["F",
         FontWeight->"Bold"], "\:2016"}]}]]}], "\[LessEqual]", 
    SubscriptBox["\[CurlyEpsilon]", "g"]}], ",", "   ", 
   RowBox[{
    RowBox[{"\:2016", 
     RowBox[{"D", 
      StyleBox["s",
       FontWeight->"Bold"]}], "\:2016"}], "\[LessEqual]", 
    RowBox[{
     SubscriptBox["\[CurlyEpsilon]", "x"], 
     RowBox[{"\:2016", 
      RowBox[{"D", 
       StyleBox["\[Theta]",
        FontWeight->"Bold"]}], "\:2016"}]}]}], ",", "   ", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"\:2016", 
        RowBox[{"J", 
         StyleBox["s",
          FontWeight->"Bold"]}], "\:2016"}], "2"], "+", "2", "\[Gamma]", 
      SuperscriptBox[
       RowBox[{"\:2016", 
        RowBox[{"D", 
         StyleBox["s",
          FontWeight->"Bold"]}], "\:2016"}], "2"]}], 
     SuperscriptBox[
      RowBox[{"\:2016", 
       StyleBox["F",
        FontWeight->"Bold"], "\:2016"}], "2"]], "\[LessEqual]", 
    SubscriptBox["\[CurlyEpsilon]", "f"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"5172b64a-8b0f-\
6646-b6b4-b52bbaddb364"],

Cell["\<\
Diagn\[OAcute]sticos: ordem de converg\[EHat]ncia estimada (Bergou et al., Se\
\[CCedilla]. 5) e covari\[AHat]ncia assint\[OAcute]tica dos par\[AHat]metros:\
\>", "Text",ExpressionUUID->"b707e733-2c6a-d34e-b623-1a9db9d7422b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"EOC", "=", 
    FractionBox[
     RowBox[{"log", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\:2016", 
         RowBox[{"\[Del]", 
          SubscriptBox["f", 
           SubscriptBox["j", "f"]]}], "\:2016"}], "/", "max", 
        RowBox[{"{", "1", ",", 
         RowBox[{"\:2016", 
          RowBox[{"\[Del]", 
           SubscriptBox["f", "0"]}], "\:2016"}], "}"}]}], ")"}]}], 
     RowBox[{"log", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\:2016", 
         RowBox[{"\[Del]", 
          SubscriptBox["f", 
           RowBox[{
            SubscriptBox["j", "f"], "-", "1"}]]}], "\:2016"}], "/", "max", 
        RowBox[{"{", "1", ",", 
         RowBox[{"\:2016", 
          RowBox[{"\[Del]", 
           SubscriptBox["f", "0"]}], "\:2016"}], "}"}]}], ")"}]}]]}], ",", 
   "   ", 
   RowBox[{
    SubscriptBox["\[CapitalSigma]", "\[Theta]"], "\[TildeTilde]", 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["\[Sigma]", "^"], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["J", "\[DownTee]"], "J"}], ")"}], "+"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"fd6849ee-22c3-\
1e41-b9cb-1b557885c59f"]
}, Closed]],

Cell[CellGroupData[{

Cell["1.4 Implementa\[CCedilla]\[ATilde]o", "Subsection",ExpressionUUID->"72434e79-d728-c240-aa88-01a893411279"],

Cell["\<\
LM recebe a fun\[CCedilla]\[ATilde]o de res\[IAcute]duos e uma fun\[CCedilla]\
\[ATilde]o que devolve um operador jacobiano (Association com \"cn\", \"Js\", \
\"Jt\", \"st\"). Jd constr\[OAcute]i o operador denso; problemas estruturados \
(P3) fornecem o pr\[OAcute]prio operador, com o passo resolvido por \
complemento de Schur.\
\>", "Text",ExpressionUUID->"762d2265-7437-a549-9ca6-30884332f0ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "Jd", ",", " ", "LM", ",", " ", "eoc", ",", " ", "cov\[CapitalLambda]"}], 
    "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Operador", " ", "jacobiano", " ", 
