         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ChebyshevT", "[", 
            RowBox[{"k", ",", 
             RowBox[{
              RowBox[{"2", " ", 
               RowBox[{"Z", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "-", "1"}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"m", "[", "\"\<p\>\"", "]"}]}], "}"}]}], "]"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"n", "\[Times]", 
         RowBox[{"(", 
          RowBox[{"p", "+", "1"}], ")"}]}], "*)"}], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ax", ",", "ay"}], "}"}], "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Transpose", "[", 
