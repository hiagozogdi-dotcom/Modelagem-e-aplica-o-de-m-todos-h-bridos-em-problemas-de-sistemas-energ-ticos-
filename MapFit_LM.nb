             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "-", "x"}], ")"}], "/", 
        "s"}]}], ";", 
      RowBox[{"f2", "=", 
       RowBox[{"F", ".", "F"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"G", "=", 
       RowBox[{
        RowBox[{"dxy", "[", 
         RowBox[{"m", ",", 
          RowBox[{"z", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"z", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "/", "s"}]}], ";", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"G", "^", "2"}], "]"}], "]"}], "/.", " ", 
        RowBox[{"0.", "->", "1."}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Mu]", "=", 
       RowBox[{
        RowBox[{"10.", "^", 
         RowBox[{"-", "3"}]}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{"f2", ",", "$MinMachineNumber"}], "]"}]}]}], ";", 
      RowBox[{"\[Mu]b", "=", "\[Mu]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"k", "<", "kx"}], "&&", 
         RowBox[{"f2", ">", 
          RowBox[{"10.", "^", 
           RowBox[{"-", "28"}]}]}]}], ",", 
        RowBox[{
         RowBox[{"k", "++"}], ";", 
         RowBox[{"\[Gamma]", "=", 
          RowBox[{"\[Mu]", " ", "f2"}]}], ";", 
         RowBox[{"Gt", "=", 
          RowBox[{"Transpose", "[", "G", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"st", "=", 
          RowBox[{"LinearSolve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Gt", ".", "G"}], "+", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{"DiagonalMatrix", "[", 
               RowBox[{"d", "^", "2"}], "]"}]}]}], ",", 
            RowBox[{"-", 
             RowBox[{"Gt", ".", "F"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"z1", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{"Clip", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"z", "+", "st"}], ",", "bd"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"st", "=", 
          RowBox[{"z1", "-", "z"}]}], ";", 
         RowBox[{"Js", "=", 
          RowBox[{"G", ".", "st"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"pred", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"f2", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"F", "+", "Js"}], ")"}], ".", 
              RowBox[{"(", 
               RowBox[{"F", "+", "Js"}], ")"}]}], "-", 
             RowBox[{"\[Gamma]", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"d", " ", "st"}], ")"}], ".", 
               RowBox[{"(", 
                RowBox[{"d", " ", "st"}], ")"}]}]}]}], ")"}], "/", "2"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"F1", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"xy", "[", 
              RowBox[{"m", ",", 
               RowBox[{"z1", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"z1", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "-", "x"}], ")"}], "/",
            "s"}]}], ";", 
         RowBox[{"f21", "=", 
          RowBox[{"F1", ".", "F1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"\[Rho]", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"pred", ">", "0"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"f2", "-", "f21"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "pred"}], ")"}]}], ",", 
            RowBox[{"-", "1."}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"\[Rho]", ">=", "0.01"}], ",", 
           RowBox[{
            RowBox[{"z", "=", "z1"}], ";", 
            RowBox[{"F", "=", "F1"}], ";", 
            RowBox[{"f2", "=", "f21"}], ";", 
            RowBox[{"G", "=", 
             RowBox[{
              RowBox[{"dxy", "[", 
               RowBox[{"m", ",", 
                RowBox[{"z", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"z", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "/", "s"}]}], ";", 
            RowBox[{"d", "=", 
             RowBox[{"MapThread", "[", 
              RowBox[{"Max", ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"Total", "[", 
                   RowBox[{"G", "^", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"\[Mu]n", "=", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"10.", "^", 
                RowBox[{"-", "16"}]}], ",", 
               RowBox[{"\[Mu]b", "/", "5."}]}], "]"}]}], ";", 
            RowBox[{"\[Mu]b", "=", "\[Mu]"}], ";", 
            RowBox[{"\[Mu]", "=", "\[Mu]n"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"d", " ", "st"}], "]"}], "<=", 
               RowBox[{
                RowBox[{"10.", "^", 
                 RowBox[{"-", "12"}]}], " ", 
                RowBox[{"Norm", "[", 
                 RowBox[{"d", " ", "z"}], "]"}]}]}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"\[Mu]", "=", 
             RowBox[{"5.", " ", "\[Mu]"}]}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"\[Gamma]", ">", 
               RowBox[{"10.", "^", "16"}]}], ",", 
              RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}]}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{"Sqrt", "[", "f2", "]"}], ",", "k"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inv", "[", 
    RowBox[{"m_", ",", "nf_", ",", 
     RowBox[{"x", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_", "?", "NumericQ"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"First", "@", 
    RowBox[{"inv\[CapitalLambda]", "[", 
     RowBox[{"m", ",", "nf", ",", "x"}], "]"}]}]}], ";"}]}], "Input",Expressio\
nUUID->"ba2d7acc-9221-374c-8730-2749c312d8bb"]
}, Closed]],

Cell[CellGroupData[{

Cell["3.3 P3 \[LongDash] efici\[EHat]ncia como problema de erros-nas-vari\
\[AAcute]veis", "Subsection",ExpressionUUID->"12cc1278-d362-3543-9aa3-\
7c6a954e475a"],

Cell["\<\
Nos contornos digitalizados o r\[OAcute]tulo \[Eta]\:2c7c \[EAcute] exato e o \
erro est\[AAcute] na posi\[CCedilla]\[ATilde]o. As coordenadas z\:2c7c = (N\
\:2c7c, \[Beta]\:2c7c) s\[ATilde]o tratadas como latentes; \[Omega] = \
\[Sigma]_\[Eta]/\[Sigma]_g pondera erro de posi\[CCedilla]\[ATilde]o e erro \
de modelo. Para \[Omega] \[RightArrow] \[Infinity] recupera-se exatamente o \
estimador linear do v2:\
\>", "Text",ExpressionUUID->"faffad5f-86c5-9a4f-8863-cbbedc70f5fa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    StyleBox["F",
     FontWeight->"Bold"], "=", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       SqrtBox["n"]], 
      RowBox[{"[", GridBox[{
         {
          RowBox[{"\[Omega]", 
           RowBox[{"(", 
            RowBox[{
             OverscriptBox["\:1e41", "~"], 
             RowBox[{"(", 
              SubscriptBox[
               StyleBox["z",
                FontWeight->"Bold"], "j"], ")"}], "-", 
             SubscriptBox["\:1e41", "j"]}], ")"}], "/", 
           SubscriptBox["s", "1"]}]},
         {
          RowBox[{"\[Omega]", 
           RowBox[{"(", 
            RowBox[{
             OverscriptBox[
              SubscriptBox["r", "p"], "~"], 
             RowBox[{"(", 
              SubscriptBox[
               StyleBox["z",
                FontWeight->"Bold"], "j"], ")"}], "-", 
             SubscriptBox["r", 
              RowBox[{"p", ",", "j"}]]}], ")"}], "/", 
           SubscriptBox["s", "2"]}]},
         {
          RowBox[{"\[Eta]", 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox[
              StyleBox["z",
               FontWeight->"Bold"], "j"], ";", 
             StyleBox["c",
              FontWeight->"Bold"]}], ")"}], "-", 
           SubscriptBox["\[Eta]", "j"]}]}
        }], "]"}]}], "\[CirclePlus]", 
     RowBox[{
      SqrtBox["\[Lambda]"], "L", 
      StyleBox["c",
       FontWeight->"Bold"]}]}]}], ",", "   ", 
   RowBox[{"\[Omega]", "=", 
    FractionBox[
     SubscriptBox["\[Sigma]", "\[Eta]"], 
     SubscriptBox["\[Sigma]", "g"]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",ExpressionUUID->"1cfb5561-4b93-\
874f-bff9-7392ce579051"],

Cell["\<\
A Jacobiana \[EAcute] bloco-diagonal nas 2n latentes. Eliminando-as \
(complemento de Schur), o passo LM exige apenas um sistema N_c\[Times]N_c, \
custo O(n N_c\.b2) por itera\[CCedilla]\[ATilde]o:\
\>", "Text",ExpressionUUID->"49d8fa9f-fec6-ae4c-86b0-3522dbe79134"],

