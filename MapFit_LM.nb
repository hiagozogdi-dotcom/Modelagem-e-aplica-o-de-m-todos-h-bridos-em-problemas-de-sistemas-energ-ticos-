             "]"}]}], "}"}], ",", 
          RowBox[{"InterpolatingFunction", "::", "dmval"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
