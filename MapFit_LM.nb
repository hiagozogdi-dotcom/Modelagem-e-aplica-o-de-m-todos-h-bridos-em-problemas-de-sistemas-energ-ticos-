Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "xyV", ",", "dxyV", ",", "\[CapitalPhi]V", ",", "inv2V", ",", "mv2", ",", 
     "vm2"}], "]"}], ";"}], "\[IndentingNewLine]", 
