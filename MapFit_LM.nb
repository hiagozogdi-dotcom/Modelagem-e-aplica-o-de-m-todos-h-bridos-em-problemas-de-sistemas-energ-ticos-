           RowBox[{"cv\[Eta]", "[", 
            RowBox[{
            "zC", ",", " ", "eC", ",", " ", "na", ",", " ", "na", ",", " ", 
             "NrC", ",", " ", "\[Lambda]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"na", ",", " ", 
           RowBox[{"{", 
            RowBox[{"6", ",", " ", "7", ",", " ", "8"}], "}"}]}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]", ",", " ", 
           RowBox[{"{", 
            RowBox[{"3.*^-5", ",", " ", "1.*^-4", ",", " ", "3.*^-4"}], 
            "}"}]}], "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
