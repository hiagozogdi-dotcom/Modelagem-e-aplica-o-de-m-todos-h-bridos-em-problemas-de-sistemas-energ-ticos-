   ";"}], "                                ", 
  RowBox[{"(*", 
   RowBox[{"n", "\[Times]", "2"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"G", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[PartialD]", 
       RowBox[{"(", 
        RowBox[{"\:1e41", ",", "rp"}], ")"}]}], "/", 
      RowBox[{"\[PartialD]", 
       RowBox[{"(", 
        RowBox[{"N", ",", "\[Beta]"}], ")"}]}]}], " ", "para", " ", "todos", " ",
      "os", " ", 
     RowBox[{"pontos", ":", 
      RowBox[{"n", "\[Times]", "2", "\[Times]", "2"}]}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dxyV", "[", 
     RowBox[{"m_", ",", "Z_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Z", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"u", "=", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"Z", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "-", "1"}]}], ",", 
        RowBox[{"p", "=", 
         RowBox[{"m", "[", "\"\<p\>\"", "]"}]}], ",", "T", ",", "T1", ",", 
        "ax", ",", "ay", ",", "ax1", ",", "ay1"}], "}"}], ",", 
      RowBox[{
       RowBox[{"T", "=", 
        RowBox[{"Transpose", "@", 
