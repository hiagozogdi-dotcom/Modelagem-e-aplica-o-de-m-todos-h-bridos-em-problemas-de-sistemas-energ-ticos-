Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Tau]0", " ", "=", " ", 
    RowBox[{
    "RegularExpression", "[", "\"\<^([A-Z][A-Z0-9])  - ?(.*)$\>\"", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"\[CurlyRho]", "[", "f_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"L", ",", " ", "B"}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"L", " ", "=", " ", 
      RowBox[{"Import", "[", 
       RowBox[{"f", ",", " ", "\"\<Lines\>\"", ",", " ", 
        RowBox[{"CharacterEncoding", " ", "->", " ", "\"\<UTF8\>\""}]}], 
       "]"}]}], ";", "\n", "  ", 
     RowBox[{"B", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"SequenceSplit", "[", 
         RowBox[{"L", ",", " ", 
          RowBox[{"{", 
           RowBox[{"s_String", " ", "/;", " ", 
            RowBox[{"StringStartsQ", "[", 
             RowBox[{"s", ",", " ", "\"\<ER  -\>\""}], "]"}]}], "}"}]}], 
         "]"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"AnyTrue", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{
            RowBox[{"StringStartsQ", "[", 
             RowBox[{"#", ",", " ", "\"\<TY  -\>\""}], "]"}], " ", "&"}]}], 
          "]"}], " ", "&"}]}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"Function", "[", 
