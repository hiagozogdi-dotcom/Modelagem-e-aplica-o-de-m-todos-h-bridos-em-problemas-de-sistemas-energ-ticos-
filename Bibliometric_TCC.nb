Cell[CellGroupData[{

Cell["Lacuna de pesquisa ", "Section",
 CellChangeTimes->{
  4.004259436958208*^9},ExpressionUUID->"3bf15d2f-a972-ef43-932b-\
a4fe8a73a0fc"],

Cell["\<\
 (Q1: avalia\[CCedilla]\[ATilde]o energ\[EAcute]tica de syngas em TG; Q2: IA \
+ otimiza\[CCedilla]\[ATilde]o em TG) j\[AAcute] se encontram na literatura. \
M\[EAcute]tricas: \[CapitalPhi] = N(Q3) / min(N(Q1), N(Q2)), com Q3 = syngas \
\[And] TG \[And] (IA \[Or] otimiza\[CCedilla]\[ATilde]o); e \[CapitalPhi]\
\[CloseCurlyQuote] = N(Q1 \:2229 Q2) / min(N(Q1), N(Q2)), a sobreposi\
\[CCedilla]\[ATilde]o exata entre os dois panoramas (documentos presentes nas \
duas queries, comparados pelo DOI/t\[IAcute]tulo). \[CapitalPhi]\
\[CloseCurlyQuote] \[EAcute] mais rigoroso, pois Q3 aceita otimiza\[CCedilla]\
\[ATilde]o sem IA. \[CapitalPhi] \[LessLess] 1 \[EAcute] a evid\[EHat]ncia \
quantitativa de que existe uma lacuna\
\>", "Text",ExpressionUUID->"bbcc2539-62ff-f942-a5c4-5905a5ad2c23"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]", " ", "=", " ", 
   RowBox[{"Intersection", "[", 
    RowBox[{
     RowBox[{"\[Iota]", " ", "/@", " ", 
