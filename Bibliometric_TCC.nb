             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"StringCases", "[", 
                 RowBox[{"b", ",", " ", 
                  RowBox[{"\[Tau]0", " ", ":>", " ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<$1\>\"", ",", " ", "\"\<$2\>\""}], "}"}]}]}],
                  "]"}], ",", " ", "1"}], "]"}], ",", " ", 
              RowBox[{"First", " ", "->", " ", "Last"}]}], "]"}]}], "}"}], ",",
           "\n", "     ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Title\>\"", " ", "->", " ", 
             RowBox[{"First", "@", 
              RowBox[{"Lookup", "[", 
               RowBox[{"g", ",", " ", "\"\<TI\>\"", ",", " ", 
                RowBox[{"{", "\"\<\>\"", "}"}]}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
