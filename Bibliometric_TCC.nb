     RowBox[{"n", "[", "\"\<Q1\>\"", "]"}], ",", " ", 
     RowBox[{"n", "[", "\"\<Q2\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalPhi]3", " ", "=", " ", 
   RowBox[{"N", "[", 
