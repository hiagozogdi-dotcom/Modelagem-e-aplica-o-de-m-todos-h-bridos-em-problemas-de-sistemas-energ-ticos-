     RowBox[{"\[Iota]", " ", "/@", " ", 
      RowBox[{"\[CapitalDelta]", "[", "\"\<Q3\>\"", "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
