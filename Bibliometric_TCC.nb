          RowBox[{"r1", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "x", " ", "r2"}], ")"}]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "x"}], "+", "r1", "+", "r2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", "r1", "-", "r2"}], ")"}], " ", 
        RowBox[{"(", 
