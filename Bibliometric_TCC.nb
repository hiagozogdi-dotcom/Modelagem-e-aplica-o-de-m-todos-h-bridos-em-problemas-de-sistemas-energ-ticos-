Cell[CellGroupData[{

Cell["Documentos mais citados (Q1) ", "Section",
 CellChangeTimes->{
  4.004259434125267*^9},ExpressionUUID->"56330d7a-f487-624a-bf6d-\
1096d907088c"],

Cell["\<\
Trabalhos de maior impacto. Cita\[CCedilla]\[OTilde]es totais favorecem \
artigos antigos; por isso h\[AAcute] tamb\[EAcute]m \
cita\[CCedilla]\[OTilde]es por ano = cita\[CCedilla]\[OTilde]es / (ano \
corrente \[Minus] ano de publica\[CCedilla]\[ATilde]o), que destaca trabalhos \
recentes influentes. Esses artigos s\[ATilde]o as refer\[EHat]ncias obrigat\
\[OAcute]rias da revis\[ATilde]o. Use a Tabela 4 no texto; a Tabela 5 serve \
para n\[ATilde]o deixar de fora trabalhos recentes importantes.\
\>", "Text",ExpressionUUID->"7d4168da-7cd2-524b-91f4-02fcdca91193"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "linhas", " ", "da", " ", "tabela", " ", "para", " ", "uma", " ", "lista", 
    " ", "de", " ", "registros"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Zeta]", "[", "l_", "]"}], " ", ":=", " ", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "@", "#2"}], ",", " ", 
          RowBox[{"\[Tau]s", "[", 
           RowBox[{
            RowBox[{"#1", "[", "\"\<Title\>\"", "]"}], ",", " ", "70"}], 
           "]"}], ",", " ", 
          RowBox[{"#1", "[", "\"\<Year\>\"", "]"}], ",", " ", 
          RowBox[{"\[Tau]s", "[", 
           RowBox[{
            RowBox[{"#1", "[", "\"\<Source title\>\"", "]"}], ",", " ", 
            "35"}], "]"}], ",", "\n", "     ", 
          RowBox[{"#1", "[", "\"\<Cited by\>\"", "]"}], ",", " ", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#1", "[", "\"\<Cited by\>\"", "]"}], "/", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"tc", " ", "-", " ", 
                RowBox[{"#1", "[", "\"\<Year\>\"", "]"}]}], ",", " ", "1"}], 
              "]"}]}], ",", " ", "0.1"}], "]"}]}], "}"}], " ", "&"}], ",", 
       " ", "l"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"vers\[ATilde]o", " ", "completa", " ", "para", " ", "exportar"}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
