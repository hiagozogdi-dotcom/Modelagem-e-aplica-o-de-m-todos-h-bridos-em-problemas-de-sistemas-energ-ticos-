           RowBox[{"\[CapitalDelta]", "[", "q", "]"}]}], "]"}]}]}], ",", "t", 
       ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"t", "=", 
       RowBox[{"TakeLargest", "[", 
        RowBox[{"a", ",", "10"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"a", ",", "\"\<Brazil\>\""}], "]"}], "&&", 
         RowBox[{"!", 
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"t", ",", "\"\<Brazil\>\""}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"k", "=", 
          RowBox[{"First", "@", 
           RowBox[{"FirstPosition", "[", 
            RowBox[{
             RowBox[{"Keys", "@", 
              RowBox[{"ReverseSort", "@", "a"}]}], ",", "\"\<Brazil\>\""}], 
            "]"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"posi\[CCedilla]\[ATilde]o", " ", "no", " ", "ranking"}], 
          "*)"}], 
         RowBox[{"Append", "[", 
          RowBox[{"t", ",", 
           RowBox[{
            RowBox[{"\"\<Brazil (\>\"", "<>", 
             RowBox[{"ToString", "@", "k"}], "<>", "\"\<\.ba)\>\""}], "->", 
            RowBox[{"a", "[", "\"\<Brazil\>\"", "]"}]}]}], "]"}]}], ",", 
        "t"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"92392ff2-\
1794-5748-8106-adc28f47f07a"],

