Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"CAGR", " ", "entre", " ", "os", " ", "extremos"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Kappa]f", "[", 
     RowBox[{"g_", ",", " ", 
      RowBox[{"{", 
       RowBox[{"a_", ",", " ", "b_"}], "}"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"g", "[", "a", "]"}], " ", "==", " ", "0"}], ",", " ", 
      RowBox[{
      "Missing", "[", "\"\<ano inicial sem publica\[CCedilla]\[ATilde]o\>\"", 
       "]"}], ",", "\n", "   ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"g", "[", "b", "]"}], "/", 
           RowBox[{"g", "[", "a", "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"b", " ", "-", " ", "a"}], ")"}]}], ")"}]}], " ", "-", 
        " ", "1"}], "]"}]}], "]"}]}], ";"}]}]], "Input",ExpressionUUID->\
"0df35bd1-cd8e-d64f-a29a-ecf803377b47"],

Cell[BoxData[
 RowBox[{
