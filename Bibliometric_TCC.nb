                RowBox[{"StringCases", "[", 
                 RowBox[{
                  RowBox[{"First", "@", 
                   RowBox[{"Lookup", "[", 
                    RowBox[{"g", ",", " ", "\"\<PY\>\"", ",", " ", 
                    RowBox[{"{", "\"\<\>\"", "}"}]}], "]"}]}], ",", " ", 
                  RowBox[{"DigitCharacter", " ", ".."}]}], "]"}], ",", 
                " ", "\"\<0\>\""}], "]"}]}]}], ",", "\n", "       ", 
            RowBox[{"\"\<Source title\>\"", " ", "->", " ", 
             RowBox[{"First", "@", 
              RowBox[{"Lookup", "[", 
               RowBox[{"g", ",", " ", "\"\<T2\>\"", ",", " ", 
                RowBox[{"{", "\"\<\>\"", "}"}]}], "]"}]}]}], ",", "\n", 
            "       ", 
            RowBox[{"\"\<DOI\>\"", " ", "->", " ", 
             RowBox[{"First", "@", 
              RowBox[{"Lookup", "[", 
               RowBox[{"g", ",", " ", "\"\<DO\>\"", ",", " ", 
                RowBox[{"{", "\"\<\>\"", "}"}]}], "]"}]}]}], ",", "\n", 
            "       ", 
            RowBox[{"\"\<Author Keywords\>\"", " ", "->", " ", 
             RowBox[{"StringRiffle", "[", 
              RowBox[{
