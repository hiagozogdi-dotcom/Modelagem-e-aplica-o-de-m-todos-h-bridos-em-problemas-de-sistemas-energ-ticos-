     RowBox[{"n", "[", "\"\<Q3\>\"", "]"}], "/", "m"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]12", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{"n12", "/", "m"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"T6", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<N(Q1)\>\"", ",", " ", 
       RowBox[{"n", "[", "\"\<Q1\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<N(Q2)\>\"", ",", " ", 
       RowBox[{"n", "[", "\"\<Q2\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<N(Q3)\>\"", ",", " ", 
       RowBox[{"n", "[", "\"\<Q3\>\"", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<N(Q1 \:2229 Q2)\>\"", ",", " ", "n12"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\[CapitalPhi] = N(Q3)/min[N(Q1), N(Q2)]\>\"", ",", " ", 
       RowBox[{"Round", "[", 
        RowBox[{"\[CapitalPhi]3", ",", " ", "0.001"}], "]"}]}], "}"}], ",", 
     "\n", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<\[CapitalPhi]' = N(Q1 \:2229 Q2)/min[N(Q1), N(Q2)]\>\"", ",",
        " ", 
       RowBox[{"Round", "[", 
        RowBox[{"\[CapitalPhi]12", ",", " ", "0.001"}], "]"}]}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{"\[Tau]g", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<Indicador\>\"", ",", " ", "\"\<Valor\>\""}], "}"}], ",", " ",
    "T6"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<tab/T6_lacuna.csv\>\"", ",", " ", 
    RowBox[{"Prepend", "[", 
     RowBox[{"T6", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Indicador\>\"", ",", " ", "\"\<Valor\>\""}], "}"}]}], 
     "]"}], ",", " ", 
    RowBox[{"CharacterEncoding", " ", "->", " ", "\"\<UTF8\>\""}]}], "]"}], 
  ";"}], "\n"}], "Input",ExpressionUUID->"a9529051-0114-d344-afee-\
f2f6c1d5877f"],

Cell[BoxData[{
 RowBox[{
